# Copy to .env (gitignored) and adjust for your environment.
#
# The values below are saucedemo.com's publicly documented demo account -
# fine for that target, placeholders to replace the moment you point at a
# private one. Never commit .env itself.

SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce
