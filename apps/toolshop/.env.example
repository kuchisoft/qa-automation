# Copy to .env (gitignored) and adjust for your environment.
#
# The values below are practicesoftwaretesting.com's publicly documented demo
# accounts - fine for that target, placeholders to replace the moment you point
# at a private one. Never commit .env itself.

TOOLSHOP_BASE_URL=https://practicesoftwaretesting.com
TOOLSHOP_API_URL=https://api.practicesoftwaretesting.com
TOOLSHOP_ADMIN_EMAIL=admin@practicesoftwaretesting.com
TOOLSHOP_USER_EMAIL=customer2@practicesoftwaretesting.com
TOOLSHOP_PASSWORD=welcome01
